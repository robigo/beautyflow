PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/beautyflow
JWT_SECRET=replace-with-a-long-random-secret
PLATFORM_ADMIN_EMAIL=admin@example.com
CLIENT_ORIGIN=http://localhost:8080

# Password reset email (server only; never put API keys in the frontend)
RESEND_API_KEY=
PASSWORD_RESET_FROM=BeautyFlow <no-reply@example.com>
PASSWORD_RESET_URL=https://robigo.github.io/beautyflow/reset-password.html
